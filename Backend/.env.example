# ==============================================================================
# EduManagePro (EMP) — Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="EduManagePro API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Mode Tenant : "standalone" (On-premise client unique) ou "multi_tenant" (Cloud / SaaS)
TENANT_MODE="standalone"

# Sécurité & JWT
# En développement, une clé éphémère est générée si SECRET_KEY est vide.
# En production, fournissez une valeur aléatoire d'au moins 32 caractères.
SECRET_KEY=""
# Variable lue par docker-compose.yml pour éviter une clé applicative en dur.
# EMP_SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 heures

# Base de Données Principale (PostgreSQL Async via asyncpg)
# Format : postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/edumanagepro"

# En mode multi-tenant, préfixe ou hôte de la grappe de bases
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="postgres"

# Stockage local des pièces d'admission (chemin relatif au dossier Backend)
ADMISSIONS_STORAGE_DIR="storage/admissions"
ADMISSIONS_MAX_UPLOAD_BYTES=10485760

# CORS : Origines autorisées (séparées par des virgules)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080"

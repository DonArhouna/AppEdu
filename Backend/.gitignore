*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Fichiers d'environnement sensibles
.env
.env.local
.env.production
!.env.example

# Données locales SQLite de dev si applicable
*.db
*.sqlite3

# Logs & temporaires
*.log
logs/
tmp/
.DS_Store
Thumbs.db
